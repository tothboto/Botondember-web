#!/bin/sh
# Commit előtti titokellenőrzés: nem engedi, hogy a .env.local titkos értékei
# (pl. az admin jelszó) a Gitbe kerüljenek. Bekapcsolás (egyszer, a projekt mappájában):
#   git config core.hooksPath .githooks
if ! command -v node >/dev/null 2>&1; then
  echo "Figyelem: a titokellenőrzés kimaradt, mert a Node.js nem található."
  exit 0
fi
exec node scripts/check-secrets.mjs

# Mit NE töltsön fel a Git a GitHubra?

# --- Titkok (jelszó, titkos kulcsok) -------------------------------
# Minden .env fájl titkos, kivéve a jelszó nélküli mintát.
.env*
!.env.example

# A specifikáció eredeti, jelszót tartalmazó példánya.
# (A jelszó nélküli másolat a docs/SPECIFIKACIO.md fájlban van.)
botondember-weboldal-spec.md

# --- Adatbázis és feltöltött képek ---------------------------------
/data/

# --- Telepített csomagok -------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# A zászlók a flag-icons csomagból másolódnak át telepítéskor.
/public/flags/

# --- Build (fordítási) mappák ---------------------------------------
/.next/
/out/
/build
/dist

# --- Tesztek ---------------------------------------------------------
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/
/lighthouse/

# --- Egyéb -------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts

# A Claude Code helyi (gépenkénti) beállításai.
.claude/settings.local.json

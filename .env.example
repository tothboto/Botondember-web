# Minta a helyi beállításokhoz.
# Az `npm run setup` parancs ebből automatikusan elkészíti a .env.local fájlt.
# FIGYELEM: a .env.local fájlt SOHA ne töltsd fel a GitHubra (a .gitignore ezt megakadályozza).

# --- Admin kezdő adatai -------------------------------------------------
# Csak az első indításkor (seed) használja a program: a jelszó bcrypt-hash-ként
# (visszafejthetetlen formában) kerül az adatbázisba. Utána a sima jelszó innen
# törölhető, és az Admin > Fiók menüben bármikor módosítható.
# A jelszót idézőjelek közé írd (pl. a ! jel miatt).
# Ha üresen hagyod, a setup generál egy erős jelszót, és egyszer kiírja.
ADMIN_USERNAME="Botond"
ADMIN_PASSWORD=""

# --- Titkos kulcs --------------------------------------------------------
# A belépési süti aláírásához (legalább 32 bájt véletlen adat).
# Ha üres, az `npm run setup` legenerálja.
SESSION_SECRET=""

# --- Adatbázis -------------------------------------------------------------
# Helyben egy SQLite fájl. Élesítéskor ide jöhet pl. egy Turso (libSQL) cím.
DATABASE_URL="file:./data/site.db"
# Csak hosztolt libSQL (pl. Turso) esetén kell:
DATABASE_AUTH_TOKEN=""

# --- Feltöltött képek --------------------------------------------------------
UPLOADS_DIR="./data/uploads"

# --- Automatikus biztonsági mentések (visszaállítás előtt készülnek) -----------
BACKUPS_DIR="./data/backups"

# --- Süti biztonság ------------------------------------------------------------
# Élesben (npm run start) a belépési süti csak https-en (vagy localhoston) működik.
# Csak akkor írd "false"-ra, ha éles módban, http-n, más gépről teszteled
# (pl. telefonról a helyi hálózaton). Egyébként maradjon üresen.
COOKIE_SECURE=""

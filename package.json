{
  "name": "botondember-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-flags.mjs && node scripts/setup-git-hooks.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup": "tsx scripts/setup.ts",
    "predev": "tsx scripts/setup.ts --quiet",
    "dev": "next dev",
    "dev:sandbox": "tsx scripts/dev-sandbox.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:stats": "tsx scripts/db-stats.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "fonts:check": "tsx scripts/check-fonts.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "flag-icons": "^7.5.0",
    "github-slugger": "^2.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
